# Copy to .env for local dev (optional — dev uses the Vite proxy by default).
#
# Leave unset in dev: requests go to /api/* and Vite proxies to
# http://127.0.0.1:8000 (see vite.config.js).
#
# In production (Vercel), set this to the deployed backend URL:
VITE_API_BASE_URL=https://tourfinderapppython.onrender.com
